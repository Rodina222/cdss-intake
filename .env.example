# --- speech to text ---
# Laptop without a GPU:
WHISPER_MODEL=small        # small for a laptop CPU
WHISPER_DEVICE=auto        # auto, cpu or cuda
WHISPER_COMPUTE=int8       # int8 on CPU, float16 on GPU
# Server with an NVIDIA GPU (best accuracy on Egyptian Arabic):
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16
# (needs the CUDA libraries and about 3 GB of free disk, see the README)

# --- language model: choose ONE backend ---
# A) Qwen running through Ollama (recommended: no quota, nothing leaves the machine)
LLM_BACKEND=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:14b       # qwen3 models run with thinking off. qwen2.5:7b-instruct is the faster, weaker option
OPENAI_API_KEY=ollama

# B) OpenCode, using a free OpenCode Zen model (needs the OpenCode command line tool; free usage has a limit)
# LLM_BACKEND=opencode
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# If your OpenCode version uses different flags, change this template. {model} and {prompt} are filled in.
# OPENCODE_CMD=opencode run -m {model} {prompt}

LLM_TIMEOUT=600
PROMPT_VERSION=v1

# Every answer must follow a question the assistant really asked. Set to 0 only to compare.
REQUIRE_QUESTION=1
QUESTION_WINDOW=300
