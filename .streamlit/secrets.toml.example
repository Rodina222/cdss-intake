# On Streamlit Community Cloud paste these in the app's Secrets box. Locally copy this file to .streamlit/secrets.toml
APP_PASSWORD = "choose-a-long-password"

# Language model for a hosted app (OpenCode is not available there). Any OpenAI-compatible API works.
# LLM_BACKEND = "openai"
# OPENAI_BASE_URL = "https://api.example.com/v1"
# OPENAI_MODEL = "model-name"
# OPENAI_API_KEY = "your-key"
