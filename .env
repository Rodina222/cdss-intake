# Copy to .env and edit. Lines starting with # are comments.

# --- speech to text (runs on this computer) ---
WHISPER_MODEL=large-v3        # small for a laptop CPU. large-v3 only with a GPU.
WHISPER_DEVICE=cuda        # auto, cpu or cuda
WHISPER_COMPUTE=float16       # int8 on CPU, float16 on GPU

# --- language model: choose ONE backend ---
# A) OpenCode, using a free OpenCode Zen model (needs OpenCode installed and signed in)
#LLM_BACKEND=opencode
#OPENCODE_MODEL=opencode/nemotron-3.5-super-vl-free
# If your OpenCode version uses different flags, change this template. {model} and {prompt} are filled in.
OPENCODE_CMD=C:/Users/Rody/AppData/Roaming/ai.opencode.desktop/cli/2.1.4-x64/opencode-cli.exe run -m {model} {prompt}

# B) A Qwen model running locally through Ollama (nothing leaves this computer)
 LLM_BACKEND=openai
 OPENAI_BASE_URL=http://localhost:11434/v1
 OPENAI_MODEL=qwen3:14b
 OPENAI_API_KEY=ollama

LLM_TIMEOUT=600
PROMPT_VERSION=v1
